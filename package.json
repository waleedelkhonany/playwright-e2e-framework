{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end UI and API test framework with Playwright and TypeScript: Page Object Model, data-driven JSON scenarios and CI on GitHub Actions",
  "license": "MIT",
  "engines": { "node": ">=20.12" },
  "scripts": {
    "setup": "npm install && playwright install chromium",
    "test": "playwright test",
    "test:ui-only": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
